#!/bin/bash
# engine-menu — таблица движков поверх панели и смена движка на месте.
#
# ЗАЧЕМ ИМЕННО ТАК. Пока агентский CLI запущен, строка ввода панели принадлежит ему: всё
# набранное уходит в модель, а не в оболочку. Поэтому команду переключения негде набрать — это и
# было главным затруднением, а не сама смена движка. Ответ: не набирать в панели вовсе. tmux
# перехватывает нажатие раньше программы, которая в панели работает, и показывает эту таблицу
# поверх неё. Работающий CLI при этом даже не узнаёт, что что-то произошло.
#
# Вызывается привязкой без префикса (см. tmux.conf эталона):
#     bind -n F9 display-popup -E -w 62 -h 18 '~/bin/engine-menu #{pane_id}'
#
# Идентификатор панели передаётся аргументом НАМЕРЕННО. Внутри всплывающего окна переменная
# TMUX_PANE указывает на само окно, а не на панель, из которой его позвали, — подставлять надо
# через #{pane_id} в привязке.
#
# Смена делается через respawn-pane -k: программа меняется В ТОЙ ЖЕ панели, её место и размер
# сохраняются. Это важно для канона парка — инженер слева, бюро справа; новое окно или новая
# панель раскладку бы разъехали.
#
# ЧТО ТЕРЯЕТСЯ ПРИ СМЕНЕ. Память движка умирает вместе с процессом, и вернуть её нельзя. Переживает
# только файл нити работы (~/.agent-thread/<роль>.md), который агент ведёт по стоячему правилу:
# новый движок стартует, читает нить и продолжает с того же места. Поэтому перед сменой таблица
# показывает, есть ли нить, и предупреждает, если её нет.
set -u

# Движки парк ставит глобально через npm, а его префикс — ~/.npm-global. В PATH этот каталог
# попадает только из ~/.bashrc, то есть в интерактивной сессии; всплывающее окно и вызовы по SSH
# его не видят, и таблица показывала бы «не установлен» для стоящих движков. Добавляем явно.
PATH="$HOME/.npm-global/bin:$HOME/bin:$PATH"

# Ключи движков лежат в ~/.config/*.env. Наследовать их нельзя: всплывающее окно получает
# окружение сервера tmux, а не панели, и таблица показывала бы «нет ключа» у настроенных
# движков. Подхватываем сами. Проверено живьём 2026-09-23.
for e in "$HOME"/.config/*.env; do [ -r "$e" ] && . "$e"; done

CONF="${ENGINES_CONF:-$HOME/etc/engines.conf}"
PANE="${1:-}"
[ -z "$PANE" ] && { echo "нужен идентификатор панели (передаётся из привязки tmux)"; sleep 3; exit 1; }
[ -r "$CONF" ] && : || { echo "нет файла движков: $CONF"; sleep 3; exit 1; }

# Роль панели — из конфиг-каталога того процесса, что в ней работает. Брать из номера панели
# нельзя: раскладку человек может поменять, а роль от этого не меняется.
pane_pid=$(tmux display-message -p -t "$PANE" '#{pane_pid}' 2>/dev/null)
role=""
for p in $pane_pid $(pgrep -P "${pane_pid:-0}" 2>/dev/null); do
    # Ошибку прячем фигурными скобками, а не перенаправлением у tr: неудачное ПЕРЕНАПРАВЛЕНИЕ
    # печатает сама оболочка, до запуска команды, и 2>/dev/null у tr его не ловит. В всплывающем
    # окне такая строка выглядела бы поломкой. Проверено: /proc/1/environ читать нельзя.
    cfg=$( { tr '\0' '\n' < "/proc/$p/environ"; } 2>/dev/null | sed -n 's/^CLAUDE_CONFIG_DIR=//p' | head -1)
    [ -n "$cfg" ] && { role=$(basename "$cfg" | sed 's/^claude-//'); break; }
done
# Чем панель была ЗАПУЩЕНА, а не как называется процесс. Определять по имени процесса нельзя:
# движки на Node показываются как "node", и таблица не узнавала бы работающий gemini. Проверено
# живьём 2026-09-23: claude виден как "claude", а gemini — как "node".
started=$(tmux display-message -p -t "$PANE" '#{pane_start_command}' 2>/dev/null)
running=$(tmux display-message -p -t "$PANE" '#{pane_current_command}' 2>/dev/null)

thread="$HOME/.agent-thread/${role:-unknown}.md"

echo
printf '  движки · %s · панель: %s\n' "$(hostname)" "${role:-роль не определена}"
echo "  ─────────────────────────────────────────────────"

while IFS='|' read -r num name cmd bin keyvar canon; do
    case "$num" in ''|\#*) continue ;; esac

    # Вхождением имени, а не точным совпадением: панель запускается через обёртку-оболочку, и имя
    # движка стоит внутри её командной строки. Шаблоны с пробелами по краям не срабатывали —
    # строка кончается кавычкой: exec gemini'
    if [ "$bin" = "$running" ] || case "$started" in *"$bin"*) true ;; *) false ;; esac; then
        state="● работает здесь"
    elif ! command -v "$bin" >/dev/null 2>&1; then
        state="✗ не установлен"
    elif [ -n "$keyvar" ] && [ -z "$(eval "printf '%s' \"\${$keyvar:-}\"")" ]; then
        state="✗ нет ключа ($keyvar)"
    else
        state="○ готов"
    fi
    printf '  %s  %-14s %s\n' "$num" "$name" "$state"
done < "$CONF"

echo "  ─────────────────────────────────────────────────"
if [ -s "$thread" ]; then
    printf '  нить работы: есть, %s строк — смена движка безопасна\n' "$(wc -l < "$thread")"
else
    printf '  нить работы: НЕТ — при смене движка работа будет потеряна\n'
fi
echo
echo "  S <номер>  поставить движок в эту панель"
echo "  K          погасить движок в этой панели"
echo "  Esc        закрыть"
echo
printf '  > '
read -r action arg

case "${action:-}" in
    [Ss])
        line=$(grep "^${arg}|" "$CONF" 2>/dev/null)
        [ -z "$line" ] && { echo "  нет движка с номером ${arg:-<пусто>}"; sleep 2; exit 0; }
        IFS='|' read -r _ name cmd bin keyvar _ <<EOF
$line
EOF
        command -v "$bin" >/dev/null 2>&1 || { echo "  $name не установлен"; sleep 2; exit 0; }
        # Пустая нить при живом движке — единственный случай, когда стоит переспросить: смена
        # уничтожит работу, которую нечем восстановить.
        if [ ! -s "$thread" ] && [ -n "$running" ] && [ "$running" != "bash" ]; then
            printf '  Нити нет, работа в панели будет потеряна. Менять? (y/N) '
            read -r yes
            case "$yes" in [Yy]*) ;; *) echo "  отменено"; sleep 1; exit 0 ;; esac
        fi
        # Движок запускается не голой командой, а через оболочку, которая сперва встаёт в рабочий
        # каталог проекта и подхватывает ключи. respawn-pane стартует программу напрямую, минуя
        # ~/.bashrc, — без этой обёртки gemini поднимался в домашнем каталоге и спрашивал, доверять
        # ли папке, то есть вставал и ждал человека. Проверено живьём 2026-09-23.
        # Домашний каталог подставляется здесь, при сборке строки, а не уезжает как $HOME внутрь:
        # tmux передаёт команду как есть, и переменная доходила до панели буквально, экранированной.
        # Проверено живьём: панель стартовала в каталоге «/workspace/project», которого нет.
        wrap="cd $HOME/workspace/project 2>/dev/null || cd $HOME; for e in $HOME/.config/*.env; do . \"\$e\" 2>/dev/null; done; exec $cmd"
        tmux respawn-pane -k -t "$PANE" "bash -c '$wrap'"
        echo "  поставлен $name"
        sleep 1
        ;;
    [Kk])
        tmux respawn-pane -k -t "$PANE" "$SHELL"
        echo "  движок погашен, в панели оболочка"
        sleep 1
        ;;
    *)
        ;;
esac
