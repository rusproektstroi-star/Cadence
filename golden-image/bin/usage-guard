#!/bin/bash
# usage-guard — хук Stop: говорит агенту, когда пора сажать сессию.
#
# Смысл. Агент не обязан помнить о расходе лимитов и не должен тратить на это внимание. Вместо
# этого ему говорят — ровно тогда, когда это меняет решение, и ровно то, что менять. Срабатывает
# после каждого ответа агента, то есть в естественной точке выбора «что делать дальше».
#
# Числа берутся из файла, который пишет usage-probe (строка состояния). Сам хук их получить не
# может: на вход хука приходят session_id, transcript_path и прочее, но не расход.
#
# Против шума. Без памяти о сказанном хук повторял бы одно и то же после каждого ответа, и агент
# перестал бы это замечать — ровно как человек перестаёт замечать постоянно горящую лампочку.
# Поэтому говорим только при ПЕРЕХОДЕ в новую полосу, а внутри полосы молчим.
#
# Против ложных тревог. Если файл состояния старше десяти минут, числа не считаются
# действительными: сессия могла простоять, лимит мог сброситься. Молчим, а не пугаем устаревшим.
set -u

STATE="$HOME/.local/state/cadence/usage.json"
BAND_FILE="$HOME/.local/state/cadence/usage-band"
STALE_SEC=600

cat >/dev/null            # вход хука не нужен, но прочитать его надо

# Нет файла — вероятно, строка состояния не настроена. Это не повод мешать работе.
[ -r "$STATE" ] || exit 0

read -r ts worst worst_of h5_reset <<EOF
$(jq -r '[(.ts // 0), (.worst // -1), (.worst_of // ""), (.five_hour_resets_at // 0)] | @tsv' "$STATE" 2>/dev/null)
EOF

[ -z "${worst:-}" ] && exit 0
awk -v w="$worst" 'BEGIN{exit !(w < 0)}' && exit 0                       # чисел нет вовсе
[ $(( $(date +%s) - ${ts:-0} )) -gt "$STALE_SEC" ] && exit 0             # числа протухли

# Полосы. Границы выбраны так, чтобы 97 % оставляли запас на саму посадку: коммит и запись
# передачи тоже стоят токенов, и если начать в 99 %, на них может не хватить.
if   awk -v w="$worst" 'BEGIN{exit !(w >= 97)}'; then band=landing
elif awk -v w="$worst" 'BEGIN{exit !(w >= 92)}'; then band=hold
elif awk -v w="$worst" 'BEGIN{exit !(w >= 80)}'; then band=watch
else band=ok
fi

prev=$(cat "$BAND_FILE" 2>/dev/null || echo ok)
[ "$band" = "$prev" ] && exit 0                                          # полоса не сменилась
printf '%s' "$band" > "$BAND_FILE" 2>/dev/null

# Падение расхода означает сброс окна — это хорошая новость, и агенту полезно её знать: можно
# снова брать крупные задачи.
case "$prev:$band" in
    landing:*|hold:watch|hold:ok|watch:ok)
        jq -cn --arg c "Лимит сброшен или расход упал: сейчас ${worst}% (${worst_of}). Ограничения на объём задач сняты." \
           '{additionalContext:$c}'
        exit 0 ;;
esac

case "$band" in
    watch)
        msg="Расход ${worst}% (${worst_of}). Прежде чем браться за новую задачу — прикинь, влезет ли она целиком. Начатое и брошенное дороже неначатого."
        ;;
    hold)
        msg="Расход ${worst}% (${worst_of}). Новых крупных задач не начинать, доводить текущую. Если текущая заведомо не помещается — сворачивай её до ближайшего целого куска."
        ;;
    landing)
        left=""
        if [ "${h5_reset:-0}" -gt 0 ]; then
            s=$(( h5_reset - $(date +%s) ))
            [ "$s" -gt 0 ] && left=" Окно лимита сбросится через $(( s/3600 ))ч$(( (s%3600)/60 ))м."
        fi
        msg="Расход ${worst}% (${worst_of}) — ПОСАДКА.${left} Заверши работу сейчас, не начиная нового: закоммить сделанное, запиши в HANDOFF.md на чём остановился, что сделано, что следующее и какие файлы тронуты, и заканчивай. Свежая сессия продолжит по этому файлу."
        ;;
    *) exit 0 ;;
esac

jq -cn --arg c "$msg" '{additionalContext:$c}'
