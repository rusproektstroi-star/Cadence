#!/bin/bash
# devpanel — generic-ручная панель управления N dev-серверами проекта. Ничего не знает о
# конкретном проекте — конфиг лежит в самом репозитории, не в этом скрипте. Отдельный слой от
# devctl/watchdog (ТЗ_жизненный_цикл_dev-серверов.md §4): devctl — автоматика (аренда/watchdog/
# systemd) для ОДНОГО сервера, devpanel — ручная визуальная панель для НЕСКОЛЬКИХ, без
# автогашения. Не трогает devctl/watchdog никак.
set -uo pipefail

CONFIG="${DEVPANEL_CONFIG:-.devpanel/services.conf}"
REPO_NAME="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"
STATE_DIR="$HOME/.cache/devpanel/$REPO_NAME"
mkdir -p "$STATE_DIR"

MACHINE_IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
[ -z "$MACHINE_IP" ] && MACHINE_IP="-"

# printf "%-Ns" паддит по БАЙТАМ, не по символам — кириллица (2 байта/символ) получает
# меньше пробелов, чем латиница той же длины, и колонки съезжают. Паддинг вручную по ${#str}
# (bash считает символы, не байты, при UTF-8-локали) — единственный надёжный вариант при
# смешении кириллицы и латиницы в таблице.
pad() {
  local str="$1" width="$2" len spaces
  len=${#str}
  spaces=$((width - len))
  [ "$spaces" -lt 0 ] && spaces=0
  printf "%s%*s" "$str" "$spaces" ""
}

if [ ! -f "$CONFIG" ]; then
  echo "devpanel: конфиг не найден: $CONFIG (запускать из корня репозитория, или задать DEVPANEL_CONFIG)" >&2
  echo "Формат — по строке на сервис: имя;порт;команда_старта;команда_бутстрапа;маркер_готовности" >&2
  echo "Пример: backend;8000;uvicorn app:main --port 8000;pip install -r requirements.txt;.venv" >&2
  exit 1
fi

declare -a NAMES PORTS STARTS BOOTSTRAPS MARKERS

load_config() {
  NAMES=(); PORTS=(); STARTS=(); BOOTSTRAPS=(); MARKERS=()
  while IFS=';' read -r name port start bootstrap marker; do
    [ -z "${name// }" ] && continue
    case "$name" in \#*) continue ;; esac
    NAMES+=("$name"); PORTS+=("$port"); STARTS+=("$start"); BOOTSTRAPS+=("$bootstrap"); MARKERS+=("$marker")
  done < "$CONFIG"
}

pidfile_for() { echo "$STATE_DIR/$1.pid"; }
logfile_for() { echo "$STATE_DIR/$1.log"; }

is_pid_alive() {
  [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

port_listening() {
  ss -Htln "sport = :$1" 2>/dev/null | grep -q .
}

status_of() {
  local i="$1"
  local pf pid=""
  pf=$(pidfile_for "${NAMES[$i]}")
  [ -f "$pf" ] && pid=$(cat "$pf" 2>/dev/null)
  local alive=false listening=false
  is_pid_alive "${pid:-}" && alive=true
  port_listening "${PORTS[$i]}" && listening=true
  if $alive && $listening; then echo "running|$pid"
  elif $alive && ! $listening; then echo "starting|$pid"
  elif ! $alive && $listening; then echo "unknown-port-busy|-"
  else echo "stopped|-"
  fi
}

draw_table() {
  clear
  printf "devpanel — %s (repo: %s)\n\n" "$(pwd)" "$REPO_NAME"
  printf "%s %s %s %s %s\n" "$(pad "#" 3)" "$(pad "Имя" 16)" "$(pad "Адрес" 22)" "$(pad "Статус" 12)" "PID"
  printf -- "----------------------------------------------------------------\n"
  local i st pid label addr
  for i in "${!NAMES[@]}"; do
    IFS='|' read -r st pid <<< "$(status_of "$i")"
    case "$st" in
      running) label="запущен" ;;
      starting) label="стартует" ;;
      unknown-port-busy) label="?порт занят не им" ;;
      stopped) label="остановлен" ;;
      *) label="$st" ;;
    esac
    addr="$MACHINE_IP:${PORTS[$i]}"
    printf "%s %s %s %s %s\n" "$(pad "$((i+1))" 3)" "$(pad "${NAMES[$i]}" 16)" "$(pad "$addr" 22)" "$(pad "$label" 12)" "$pid"
  done
  printf "\nКоманды: s N (запустить) | k N (убить) | r (обновить) | q (выход)\n"
  if [ "${#NAMES[@]}" -gt 1 ]; then
    local hint i
    hint="Для полноценной работы приложения обычно нужны все:"
    for i in "${!NAMES[@]}"; do hint="$hint s $((i+1)),"; done
    printf "%s\n" "${hint%,}"
  fi
  printf "> "
}

ensure_bootstrap() {
  local i="$1"
  local marker="${MARKERS[$i]:-}" bootstrap="${BOOTSTRAPS[$i]:-}"
  if [ -n "$marker" ] && [ ! -e "$marker" ] && [ -n "$bootstrap" ]; then
    echo "Маркер '$marker' отсутствует — выполняю бутстрап: $bootstrap"
    bash -c "$bootstrap"
    sleep 1
  fi
}

start_service() {
  local i="$1" name pf lf
  name="${NAMES[$i]}"; pf=$(pidfile_for "$name"); lf=$(logfile_for "$name")
  if [ -f "$pf" ] && is_pid_alive "$(cat "$pf" 2>/dev/null)"; then
    echo "$name уже запущен"; sleep 1; return
  fi
  ensure_bootstrap "$i"
  nohup bash -c "${STARTS[$i]}" >"$lf" 2>&1 &
  echo $! > "$pf"
  sleep 1
}

kill_service() {
  local i="$1" name pf pid
  name="${NAMES[$i]}"; pf=$(pidfile_for "$name")
  if [ -f "$pf" ]; then
    pid=$(cat "$pf" 2>/dev/null)
    is_pid_alive "${pid:-}" && kill "$pid" 2>/dev/null
    rm -f "$pf"
  fi
  sleep 1
}

load_config
if [ "${#NAMES[@]}" -eq 0 ]; then
  echo "devpanel: конфиг '$CONFIG' пуст или все строки закомментированы" >&2
  exit 1
fi

while true; do
  draw_table
  read -r cmd arg || { clear; exit 0; }
  case "$cmd" in
    s) idx=$((${arg:-0}-1)); [ "$idx" -ge 0 ] 2>/dev/null && [ "$idx" -lt "${#NAMES[@]}" ] && start_service "$idx" ;;
    k) idx=$((${arg:-0}-1)); [ "$idx" -ge 0 ] 2>/dev/null && [ "$idx" -lt "${#NAMES[@]}" ] && kill_service "$idx" ;;
    r) : ;;
    q) clear; exit 0 ;;
    *) : ;;
  esac
done
