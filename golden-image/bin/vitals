#!/bin/bash
# vitals — пульс изнутри гостя раз в 5 секунд.
# Ключевое поле — drift: насколько фактический интервал отличается от 5 с. Если гость встал,
# следующая строка придёт с drift=90 и покажет, что творилось ПЕРЕД остановкой. Разреженность
# журнала при этом ни при чём — мерим собственным таймером, а не чужими записями.
set -u
LOG="$HOME/vitals.log"
INTERVAL=5
prev=$(date +%s)

while true; do
  now=$(date +%s)
  drift=$(( now - prev - INTERVAL ))
  prev=$now

  read -r load1 _ < /proc/loadavg
  mem=$(free -m | awk '/^Mem:/ {printf "%d/%d", $3, $2}')
  swap=$(free -m | awk '/^Swap:/ {print $3}')
  # процессы в непрерываемом сне (D) — прямой признак застрявшего ввода-вывода
  dstate=$(ps -eo state= | grep -c '^D' || true)
  # ожидание ввода-вывода и готовность CPU, один замер
  read -r wa st <<<"$(vmstat 1 2 | tail -1 | awk '{print $16, $17}')"
  top=$(ps -eo pcpu,comm --sort=-pcpu --no-headers | head -1 | awk '{printf "%s %s%%", $2, $1}')

  flag=""
  [ "$drift" -gt 10 ] && flag="  <<< ОСТАНОВКА ${drift}с"

  printf '%s drift=%+ds load=%s mem=%sMB swap=%sMB D=%s wa=%s st=%s top=%s%s\n' \
    "$(date -Iseconds)" "$drift" "$load1" "$mem" "$swap" "$dstate" "$wa" "$st" "$top" "$flag" >> "$LOG"

  # держим файл в разумных пределах — сутки при интервале 5 с
  if [ "$(( now % 3600 ))" -lt "$INTERVAL" ]; then
    tail -n 20000 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
  fi
  sync -d "$LOG" 2>/dev/null || true   # запись должна пережить жёсткую остановку
  sleep "$INTERVAL"
done
